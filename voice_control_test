import pyautogui
import speech_recognition as sr
import pyttsx3

# Initialize recognizer and text-to-speech engine
recognizer = sr.Recognizer()
engine = pyttsx3.init()

# Set the voice property for the text-to-speech engine
voices = engine.getProperty('voices')
engine.setProperty('voice', voices[1].id)

def talk(text):
    """Function to convert text to speech."""
    engine.say(text)
    engine.runAndWait()

def take_command():
    """Function to take voice commands from the microphone."""
    try:
        with sr.Microphone() as source:
            print('Listening...')
            audio = recognizer.listen(source)
            command = recognizer.recognize_google(audio)
            command = command.lower()
            print(f"Recognized command: {command}")
    except sr.UnknownValueError:
        print("Sorry, I did not get that.")
        command = ""
    except sr.RequestError:
        print("Request Error from Google Speech Recognition service")
        command = ""
    return command

def execute_command(command):
    """Function to execute the command using pyautogui."""
    command_map = {
        'next tab': ('ctrl', 'tab'),
        'next table': ('ctrl', 'tab'),
        'next time': ('ctrl', 'tab'),
        'previous tab': ('ctrl', 'shift', 'tab'),
        'previous table': ('ctrl', 'shift', 'tab'),
        'previous time': ('ctrl', 'shift', 'tab'),
        'close tab': ('ctrl', 'w'),
        'close table': ('ctrl', 'w'),
        'close time': ('ctrl', 'w'),
        'reopen closed tab': ('ctrl', 'shift', 't'),
        'reopen closed table': ('ctrl', 'shift', 't'),
        'closed table': ('ctrl', 'shift', 't'),
        'reopen': ('ctrl', 'shift', 't'),
        "play":("playpause"),
        'pause':("playpause"),
        'mute':('volumemute'),
        'volume down':('volumedown'),
        'volume up':('volumeup'),
        'select all': ("ctrl", "a"),
        'copy': ("ctrl", "c"),
        'paste': ("ctrl", "v"),
        'cut':('ctrl', 'x'),
        'undo': ("ctrl", "z"),
        'redo': ("ctrl", "y"),
        'bold': ('ctrl', 'b'),
        'italic': ('ctrl', 'i'),
        'underline':('ctrl', 'u'),
        'maximize': ('win', 'up'),
        'minimize': ('win', 'm'),
        'close window':('ctrl', 'shift', 'w'),
        'switch window':('alt','tab'),
        'snap left':('win', 'left'),
        'snap right': ("win", "right"),
        'refresh':('ctrl','r'),
        'back': ('alt','left'),
        'forward':('alt','right'),
        'bookmark':('ctrl','d'),
    }

    for key in command_map:
        if key in command:
            pyautogui.hotkey(*command_map[key])
            talk(f'Executed command: {key}')
            return

    talk('Sorry, I cannot do that.')

def main():
    """Main function to run the voice command loop."""
    talk('How can I assist you?')
    recognizer.adjust_for_ambient_noise(sr.Microphone(), duration=1)  # Adjust for ambient noise once at the beginning
    while True:
        command = take_command()
        if 'exit' in command or 'quit' in command or 'stop' in command:
            talk('Goodbye!')
            break
        execute_command(command)

if _name_ == "_main_":
    main()
